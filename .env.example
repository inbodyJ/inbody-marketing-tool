# ============================================================
# InBody Marketing Tool — 환경 변수 템플릿
# 이 파일을 복사해 .env 로 이름을 바꾸고 실제 키를 입력하세요.
# .env 파일은 절대 Git에 커밋하지 마세요.
# ============================================================

# ─── OpenRouter API (Claude, Gemini 등 통합) ─────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Claude (Anthropic) 직접 API — OpenRouter 사용 시 불필요 ──
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Gemini 직접 API — OpenRouter 사용 시 불필요 ────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Canva API ────────────────────────────────────────────────
# https://www.canva.com/developers/
CANVA_API_KEY=your_canva_api_key_here

# ─── Flask 서버 설정 ──────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false
